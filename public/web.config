<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: a .webmanifest kiterjesztést alapból nem szolgálja ki (404) -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
